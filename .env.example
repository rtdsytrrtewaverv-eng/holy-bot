# ==================== .env.example ====================
# Токен бота (от @BotFather)
BOT_TOKEN=ваш_токен_бота
# Ваш Telegram ID (число, узнать у @userinfobot)
ADMIN_ID=ваш_user_id
# ID канала (например -1001234567890)
CHANNEL_ID=-100...

# --- Необязательно ---
# Папка для хранения БД. На bothost рекомендуется /app/data
# (сохраняется при перезапуске контейнера).
# DATA_DIR=/app/data
# Либо явный полный путь к файлу БД:
# DB_PATH=/app/data/bot_data.db
